{
  "name": "tw-badminton-info",
  "version": "1.0.0",
  "private": true,
  "description": "台灣羽球通：全台羽球教學、場館、零打團、球具資訊（Web / PWA / iOS）",
  "license": "MIT",
  "scripts": {
    "dev": "python3 -m http.server 8765 --directory web",
    "data": "python3 scripts/fetch_ptt.py && python3 scripts/fetch_venues.py && python3 scripts/build_manifest.py",
    "check": "python3 scripts/check_links.py && python3 scripts/build_manifest.py",
    "validate": "python3 scripts/validate.py",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
