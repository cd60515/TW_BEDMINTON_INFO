    {
      "id": "racket", "icon": "🏸", "title": "球拍怎麼挑", "videoTopic": "racket",
      "points": [
        {"k": "重量（U 數）", "v": "數字越大越輕。3U 約 85–89g（力量型）、4U 約 80–84g（最泛用，新手首選）、5U 約 75–79g（輕快、女性與青少年）。"},
        {"k": "平衡點", "v": "頭重（>295mm）利於殺球與後場；平衡（285–295mm）攻守兼備；頭輕（<285mm）揮拍快，適合雙打前場與防守。"},
        {"k": "中桿硬度", "v": "軟桿容易彈、好發力，適合新手；硬桿控制精準、回饋快，需要較好的揮拍速度。"},
        {"k": "握把（G 數）", "v": "數字越大越細。台灣常見 G5／G6，可再纏握把布調整。"},
        {"k": "預算", "v": "入門 1,000–2,500 元已足夠；中階 2,500–4,500 元；高階 5,000 元以上。不建議新手直接買高階硬桿。"}
      ]
    },
    {
      "id": "string", "icon": "🧵", "title": "穿線與磅數", "videoTopic": "string",
      "points": [
        {"k": "磅數建議", "v": "新手 20–22 磅；一般球友 22–25 磅；進階 25–28 磅。磅數越高越好控但甜區越小、越吃力。"},
        {"k": "線的特性", "v": "細線（0.65–0.68mm）彈性與擊球聲佳；粗線（0.70mm 以上）耐打。"},
        {"k": "多久換線", "v": "每週打 2–3 次者約 2–3 個月換一次；斷線或球感明顯變鬆就該換。"},
        {"k": "注意", "v": "請確認球拍標示的最高磅數，超過可能導致斷拍且不在保固範圍。"}
      ]
    },
    {
      "id": "shoes", "icon": "👟", "title": "羽球鞋", "videoTopic": "shoes",
      "points": [
        {"k": "為什麼一定要穿羽球鞋", "v": "膠底止滑、側向支撐強、鞋底低，能大幅降低扭傷。慢跑鞋鞋底高且軟，側向移動容易翻腳。"},
        {"k": "尺寸", "v": "傍晚試穿、穿運動襪試穿，腳趾前保留約 0.5–1 公分，避免急停撞出黑指甲。"},
        {"k": "寬楦", "v": "台灣腳型偏寬，可選擇 Wide 或寬楦款。"},
        {"k": "專鞋專用", "v": "只在室內球場穿，鞋底才不會沾灰變滑。"}
      ]
    },
    {
      "id": "shuttle", "icon": "🪶", "title": "羽毛球（球）", "videoTopic": "racket",
      "points": [
        {"k": "羽毛 vs 尼龍", "v": "羽毛球飛行軌跡標準、手感好，比賽與零打團主流；尼龍球耐打便宜，適合戶外或初學練習。"},
        {"k": "球速（號數）", "v": "依氣溫選擇：夏天高溫用較慢的球（如 76／77 號），冬天低溫用較快的球（78／79 號），以實際試打為準。"},
        {"k": "保存", "v": "放在陰涼處，太乾燥羽毛易斷，可將球筒放在略有濕度的環境。"}
      ]
    },
